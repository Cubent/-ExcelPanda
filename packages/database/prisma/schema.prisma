generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ExamType {
  STEP_1
  STEP_2_CK
  STEP_3
  ABIM
}

enum PrepStage {
  JUST_STARTING
  MID_WAY
  CRAMMING
}

enum TimedPreference {
  TIMED
  UNTIMED
}

enum NextExamPlan {
  YES
  NOT_YET
  NOT_SURE
}

// The exam a user selected during onboarding. Locked for 30 days from
// examSelectedAt; changing exams after that resets the timer (enforced in
// application code, not the database).
model UserPreference {
  id             String   @id @default(cuid())
  clerkUserId    String   @unique
  exam           ExamType
  examSelectedAt DateTime @default(now())
  // Systems the user has chosen to drill via /dashboard/topics. Empty means
  // "All topics" — no filter, sample from the whole exam.
  focusSystemIds String[] @default([])
  // Onboarding questionnaire answers. Nullable: only set once, at the end of
  // onboarding, all together — never partially saved mid-flow.
  prepStage       PrepStage?
  isRetake        Boolean?
  timedPreference TimedPreference?
  nextExamPlan    NextExamPlan?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("user_preferences")
}

// Mirrors a Stripe subscription for one user. Written and kept in sync
// entirely by the /api/webhooks/stripe handler, never by application code
// directly — the webhook is the single source of truth since Stripe is the
// system of record for billing state. `status` stores Stripe's own status
// string verbatim (trialing/active/past_due/canceled/...) rather than a
// Prisma enum, so a new Stripe status never requires a migration here.
model Subscription {
  id                   String    @id @default(cuid())
  clerkUserId          String    @unique
  stripeCustomerId     String
  stripeSubscriptionId String    @unique
  status               String
  priceId              String
  currentPeriodEnd     DateTime
  trialEnd             DateTime?
  cancelAtPeriodEnd    Boolean   @default(false)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@map("subscriptions")
}

enum ObjectiveStatus {
  NOT_SEEN
  LEARNING
  REVIEW
  MASTERED
}

enum ErrorType {
  CONCEPT
  RECALL
  CARELESS
  TIME
}

// Where a logged practice-exam score came from. Used only to label it back to
// the user; the score predictor deliberately does not weight sources
// differently (we have no data to justify doing so).
enum AssessmentSource {
  NBME
  UWSA
  FREE_120
  OTHER
}

enum SessionMode {
  SEMESTER
  DEDICATED
  RESERVE
  // A session drilling the "AI Generated" system (packages/database/ai-practice.ts),
  // kept distinct so it never collides with a user's in-progress real practice set.
  AI_GENERATED
}

// Organ system / discipline bucket a learning objective belongs to, per exam.
// e.g. { examType: STEP_1, name: "Cardiovascular" }
model System {
  id         String              @id @default(cuid())
  examType   ExamType
  name       String
  sortOrder  Int                 @default(0)
  objectives LearningObjective[]
  createdAt  DateTime            @default(now())

  @@unique([examType, name])
  @@map("systems")
}

// The atomic testable fact. Real NBME content is tagged along two axes:
// the organ system (System, above) and the discipline/process (Pathology,
// Physiology, Pharmacology, ...). yieldWeight (0-100) drives how often this
// objective is prioritized when picking the next question. `summary` is the
// short recap shown on the review/explanation screen (falls back to title).
model LearningObjective {
  id          String                  @id @default(cuid())
  systemId    String
  system      System                  @relation(fields: [systemId], references: [id], onDelete: Cascade)
  examType    ExamType
  discipline  String
  title       String
  summary     String?
  yieldWeight Int                     @default(50)
  // AI-generated titles only: when true, the generated question for this
  // title MUST embed a markdown table (labs/vitals/NCS/reflex data, etc.);
  // when false, it must not. Decided once per title, not left to the model's
  // per-question judgment, so table usage stays deliberate rather than
  // inconsistent across a set.
  requiresTable Boolean               @default(false)
  questions   Question[]
  progress    UserObjectiveProgress[]
  notes       UserQuestionNote[]
  studyGuideEntries StudyGuideEntry[]
  createdAt   DateTime                @default(now())

  @@index([examType, systemId])
  @@map("learning_objectives")
}

// A "concerning learning area" surfaced by the Study Guide: one per
// clerkUserId+learningObjective the user has missed at least once. `summary`
// is AI-generated from ONLY that objective's own question/answer history
// (never the user's broader profile or other objectives). `isReviewed` is
// set by the user marking it studied, and flips back to false the next time
// `missedCount` grows past what it was when marked reviewed (see qbank.ts).
model StudyGuideEntry {
  id                  String            @id @default(cuid())
  clerkUserId         String
  learningObjectiveId String
  learningObjective   LearningObjective @relation(fields: [learningObjectiveId], references: [id], onDelete: Cascade)
  summary             String
  missedCount         Int               @default(0)
  attemptCount        Int               @default(0)
  reviewedAtMissCount Int?
  isReviewed          Boolean           @default(false)
  lastAttemptAt       DateTime?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  @@unique([clerkUserId, learningObjectiveId])
  @@index([clerkUserId, isReviewed])
  @@map("study_guide_entries")
}

// variationGroupId groups multiple questions that test the SAME learning
// objective from different angles, so spaced repetition can resurface a
// missed concept without repeating the literal same question.
model Question {
  id                  String                @id @default(cuid())
  learningObjectiveId String
  learningObjective   LearningObjective     @relation(fields: [learningObjectiveId], references: [id], onDelete: Cascade)
  variationGroupId    String
  stem                String
  explanation         String
  difficulty          Int                   @default(3)
  choices             AnswerChoice[]
  attempts            UserQuestionAttempt[]
  sessionQuestions    SessionQuestion[]
  bookmarks           UserBookmark[]
  createdAt           DateTime              @default(now())

  @@index([learningObjectiveId])
  @@index([variationGroupId])
  @@map("questions")
}

// `explanation` is the per-choice rationale ("why this is right/wrong"),
// distinct from Question.explanation (the overall concept explanation).
model AnswerChoice {
  id          String                @id @default(cuid())
  questionId  String
  question    Question              @relation(fields: [questionId], references: [id], onDelete: Cascade)
  text        String
  isCorrect   Boolean               @default(false)
  explanation String?
  sortOrder   Int                   @default(0)
  attempts    UserQuestionAttempt[]

  @@map("answer_choices")
}

// Per-user, per-learning-objective mastery state. This is the scheduling
// layer that makes spaced repetition work: easeFactor/interval/nextReviewAt
// follow a simplified binary-response SM-2 (see packages/database/qbank.ts).
model UserObjectiveProgress {
  id                  String            @id @default(cuid())
  clerkUserId         String
  learningObjectiveId String
  learningObjective   LearningObjective @relation(fields: [learningObjectiveId], references: [id], onDelete: Cascade)
  status              ObjectiveStatus   @default(NOT_SEEN)
  easeFactor          Float             @default(2.5)
  interval            Int               @default(0)
  correctStreak       Int               @default(0)
  nextReviewAt        DateTime?
  lastAttemptAt       DateTime?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  @@unique([clerkUserId, learningObjectiveId])
  @@index([clerkUserId, nextReviewAt])
  @@map("user_objective_progress")
}

model UserQuestionAttempt {
  id               String        @id @default(cuid())
  clerkUserId      String
  questionId       String
  question         Question      @relation(fields: [questionId], references: [id], onDelete: Cascade)
  chosenAnswerId   String?
  chosenAnswer     AnswerChoice? @relation(fields: [chosenAnswerId], references: [id])
  isCorrect        Boolean
  // True when this attempt was served as a due spaced-repetition review
  // rather than new material. Drives the "answer 1 review" unlock condition.
  isReview         Boolean       @default(false)
  errorType        ErrorType?
  timeSpentSeconds Int?
  attemptedAt      DateTime      @default(now())
  // Which set this attempt belongs to, so the set-completion summary can
  // pull an authoritative per-question correct/incorrect breakdown. Nullable
  // since attempts recorded before this field existed have no session link.
  sessionId        String?
  session          StudySession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  @@index([clerkUserId])
  @@index([questionId])
  @@index([sessionId])
  @@map("user_question_attempts")
}

model StudySession {
  id          String                @id @default(cuid())
  clerkUserId String
  examType    ExamType
  mode        SessionMode           @default(SEMESTER)
  createdAt   DateTime              @default(now())
  completedAt DateTime?
  questions   SessionQuestion[]
  attempts    UserQuestionAttempt[]

  @@map("study_sessions")
}

// A question served within a study session. Created as soon as the question
// is shown (answeredAt: null), so navigating away and back resumes the same
// pending question at the same step instead of picking a new one.
model SessionQuestion {
  id         String       @id @default(cuid())
  sessionId  String
  session    StudySession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  questionId String
  question   Question     @relation(fields: [questionId], references: [id], onDelete: Cascade)
  order      Int
  isReview   Boolean      @default(false)
  answeredAt DateTime?

  @@map("session_questions")
}

// A user's personal note on a learning objective (persists across variations
// of that objective, since the note is about the concept, not one question).
model UserQuestionNote {
  id                  String            @id @default(cuid())
  clerkUserId         String
  learningObjectiveId String
  learningObjective   LearningObjective @relation(fields: [learningObjectiveId], references: [id], onDelete: Cascade)
  content             String
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  @@unique([clerkUserId, learningObjectiveId])
  @@map("user_question_notes")
}

model UserBookmark {
  id          String   @id @default(cuid())
  clerkUserId String
  questionId  String
  question    Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@unique([clerkUserId, questionId])
  @@map("user_bookmarks")
}

// A practice-exam result the user logs by hand (an NBME form, UWSA, the Free
// 120, ...). These are the only inputs to the numeric score estimate on
// /dashboard/predictor: MedPrep's own question accuracy is never converted
// into a three-digit score, because its AI-generated vignettes have no
// validated mapping to real exam scores. `score` is the three-digit score
// (1-300) for exams that report one.
model PracticeAssessment {
  id          String           @id @default(cuid())
  clerkUserId String
  examType    ExamType
  source      AssessmentSource
  label       String
  score       Int
  takenAt     DateTime
  createdAt   DateTime         @default(now())

  @@index([clerkUserId, examType, takenAt])
  @@map("practice_assessments")
}

// The user's real exam result, entered voluntarily after test day. This is
// the ground truth a future calibrated predictor needs; until enough of it
// exists the estimate on /dashboard/predictor stays a wide, unvalidated
// range. `score` is null for pass/fail exams (Step 1, ABIM).
model ExamOutcome {
  id          String   @id @default(cuid())
  clerkUserId String
  examType    ExamType
  score       Int?
  passed      Boolean
  takenAt     DateTime
  createdAt   DateTime @default(now())

  @@index([clerkUserId, examType])
  @@map("exam_outcomes")
}

// ExcelPanda learner profile. One row per Clerk user, created when they
// finish onboarding. No row (or null onboardingCompletedAt) means the user
// still has to go through /onboarding before reaching the dashboard.
model UserProfile {
  id                    String    @id @default(cuid())
  clerkUserId           String    @unique
  excelLevel            String?
  goal                  String?
  answers               Json?
  xp                    Int       @default(0)
  gems                  Int       @default(0)
  onboardingCompletedAt DateTime?

  // Billing (Stripe). plan: annual | monthly | lifetime. subscriptionStatus: trialing | active | past_due | canceled | lifetime.
  stripeCustomerId      String?   @unique
  stripeSubscriptionId  String?
  plan                  String?
  subscriptionStatus    String?
  trialEndsAt           DateTime?
  currentPeriodEnd      DateTime?
  cancelAtPeriodEnd     Boolean   @default(false)

  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@map("user_profiles")
}

// ---------------------------------------------------------------------------
// ExcelPanda courses
// ---------------------------------------------------------------------------

enum LessonKind {
  LESSON
  CHEST
  TEST
}

// A course is a path made of units, each unit a row of lessons. Courses can
// exist as empty shells (no units yet); only published ones reach learners.
model Course {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  description String   @default("")
  order       Int      @default(0)
  published   Boolean  @default(false)
  units       Unit[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("courses")
}

model Unit {
  id       String   @id @default(cuid())
  courseId String
  course   Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  order    Int
  title    String
  blurb    String   @default("")
  lessons  Lesson[]

  @@unique([courseId, order])
  @@map("units")
}

model Lesson {
  id       String               @id @default(cuid())
  unitId   String
  unit     Unit                 @relation(fields: [unitId], references: [id], onDelete: Cascade)
  order    Int
  title    String
  // Lucide icon key, resolved on the client (e.g. "sigma", "gift").
  icon     String               @default("book")
  kind     LessonKind           @default(LESSON)
  xp       Int                  @default(10)
  // Key into the web app's lesson content registry. Null = no content yet.
  contentKey String?
  progress UserLessonProgress[]

  @@unique([unitId, order])
  @@map("lessons")
}

model UserLessonProgress {
  id          String   @id @default(cuid())
  clerkUserId String
  lessonId    String
  lesson      Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  completedAt DateTime @default(now())

  @@unique([clerkUserId, lessonId])
  @@index([clerkUserId])
  @@map("user_lesson_progress")
}

// One row per user per UTC day they earned anything. Drives streaks, daily
// quests, the weekly challenge and the weekly leaderboard.
model UserActivityDay {
  id          String   @id @default(cuid())
  clerkUserId String
  date        DateTime @db.Date
  xp          Int      @default(0)
  lessons     Int      @default(0)

  @@unique([clerkUserId, date])
  @@index([date])
  @@map("user_activity_days")
}
